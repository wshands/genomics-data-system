# Copy this file to .env and fill in values for local development.
# .env is gitignored — never commit it.

# ---------------------------------------------------------------------------
# AWS credentials — SSO profile
# Run first: aws sso login --profile AdministratorAccess-230407893272
# boto3, the AWS CLI, and Terraform all pick this up automatically.
# ---------------------------------------------------------------------------
AWS_PROFILE=AdministratorAccess-230407893272
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# Local PostgreSQL (matches the Docker container started by `make up`)
# ---------------------------------------------------------------------------
RDS_HOST=localhost
RDS_DB=genomics_metadata
RDS_USER=postgres
RDS_PASSWORD=postgres

# ---------------------------------------------------------------------------
# Source platforms
# ---------------------------------------------------------------------------
DNANEXUS_TOKEN=your-dnanexus-api-token
DNANEXUS_PROJECT_ID=project-XXXX
HEALTHOMICS_STORE_ID=store-XXXX

# ---------------------------------------------------------------------------
# S3 (used by the CLI path — demo uses mocked S3, so this only matters
# when running pipeline/ingest.py against real AWS)
# ---------------------------------------------------------------------------
S3_BUCKET_NAME=genomics-data-local
